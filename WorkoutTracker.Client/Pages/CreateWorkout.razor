@page "/create-workout"
@using WorkoutTracker.Client.Models
@using WorkoutTracker.Core.DTOs.Exercise
@using WorkoutTracker.Core.DTOs.Workout
@inject NavigationManager Navigation
@inject HttpClient Http
@inject WorkoutDraftSaver WorkoutDraftSaver
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Create Workout</PageTitle>

<AppHeader/>

<main class="create-workout-page">
    <button class="back-button" type="button" aria-label="Back" @onclick="GoBack">←</button>

    <h1 class="create-title">Create Workout</h1>

    <label class="field-label">DATE</label>
    <WorkoutDatePicker @bind-Value="workoutDate"/>

    <DraftExerciseList Exercises="exercises" AvailableExercises="availableExercises"/>

    <button class="save-workout-button" type="button" disabled="@isSaving" @onclick="SaveWorkout">
        @(isSaving ? "Saving..." : "Save workout")
    </button>

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <p class="form-error">@saveError</p>
    }
</main>

@code {
    private bool isSaving;
    private string? saveError;
    private DateOnly workoutDate = DateOnly.FromDateTime(DateTime.Today);
    private List<ExerciseDto> availableExercises = [];
    private List<DraftExercise> exercises = [new()];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableExercises = await Http.GetFromJsonAsync<List<ExerciseDto>>("api/exercises") ?? [];
        }
        catch (HttpRequestException)
        {
            saveError = "Could not load exercises";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/home");
    }

    private async Task SaveWorkout()
    {
        if (isSaving)
            return;

        isSaving = true;
        saveError = null;

        try
        {
            if (!exercises.Any(exercise => !string.IsNullOrWhiteSpace(exercise.SearchText)))
            {
                saveError = "Add at least one exercise";
                return;
            }

            var workoutResponse = await Http.PostAsJsonAsync("api/workouts", new CreateWorkoutDto(workoutDate));
            if (!workoutResponse.IsSuccessStatusCode)
            {
                saveError = "Workout was not saved";
                return;
            }

            var workout = await workoutResponse.Content.ReadFromJsonAsync<WorkoutDto>();
            if (workout is null)
            {
                saveError = "Workout was not saved";
                return;
            }

            var saveExercisesResult = await WorkoutDraftSaver.SaveExercisesToWorkoutAsync(
                workout.workoutId,
                exercises,
                availableExercises);

            if (!saveExercisesResult.Success)
            {
                saveError = saveExercisesResult.ErrorMessage;
                return;
            }

            Navigation.NavigateTo("/home");
        }
        catch (HttpRequestException)
        {
            saveError = "Could not connect to the API";
        }
        finally
        {
            isSaving = false;
        }
    }

}
