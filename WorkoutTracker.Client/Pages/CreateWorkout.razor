@page "/create-workout"
@using WorkoutTracker.Client.Models
@using WorkoutTracker.Core.DTOs.Exercise
@using WorkoutTracker.Core.DTOs.Set
@using WorkoutTracker.Core.DTOs.Workout
@using WorkoutTracker.Core.DTOs.WorkoutExercise
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Create Workout</PageTitle>

<AppHeader />

<main class="create-workout-page">
    <button class="back-button" type="button" aria-label="Back" @onclick="GoBack">←</button>

    <h1 class="create-title">Create Workout</h1>

    <label class="field-label">DATE</label>
    <WorkoutDatePicker @bind-Value="workoutDate" />

    <div class="exercise-editor-list">
        @foreach (var exercise in exercises)
        {
            <ExerciseCard
                @key="exercise"
                Exercise="exercise"
                AvailableExercises="availableExercises" />
        }
    </div>

    <button class="add-exercise-button" type="button" @onclick="AddExercise">
        <span>+</span> Add exercise
    </button>

    <button class="save-workout-button" type="button" disabled="@isSaving" @onclick="SaveWorkout">
        @(isSaving ? "Saving..." : "Save workout")
    </button>

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <p class="form-error">@saveError</p>
    }
</main>

@code {
    private bool isSaving;
    private string? saveError;
    private DateOnly workoutDate = DateOnly.FromDateTime(DateTime.Today);
    private List<ExerciseDto> availableExercises = [];
    private List<DraftExercise> exercises = [new()];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableExercises = await Http.GetFromJsonAsync<List<ExerciseDto>>("api/exercises") ?? [];
        }
        catch (HttpRequestException)
        {
            saveError = "Could not load exercises";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private void AddExercise()
    {
        exercises.Add(new DraftExercise());
    }

    private async Task SaveWorkout()
    {
        if (isSaving)
            return;

        isSaving = true;
        saveError = null;

        try
        {
            List<(DraftExercise Exercise, Guid ExerciseId)> exercisesToSave = [];

            foreach (var exercise in exercises)
            {
                var exerciseName = exercise.SearchText.Trim();
                if (string.IsNullOrWhiteSpace(exerciseName))
                    continue;

                var exerciseId = exercise.ExerciseId ?? FindExerciseIdByName(exerciseName);

                if (exerciseId is null)
                {
                    var createdExercise = await CreateExerciseAsync(exerciseName);
                    if (createdExercise is null)
                    {
                        saveError = $"Exercise \"{exerciseName}\" was not saved";
                        return;
                    }

                    availableExercises.Add(createdExercise);
                    exercise.ExerciseId = createdExercise.Id;
                    exercise.SearchText = createdExercise.Name;
                    exerciseId = createdExercise.Id;
                }

                exercisesToSave.Add((exercise, exerciseId.Value));
            }

            if (exercisesToSave.Count == 0)
            {
                saveError = "Add at least one exercise";
                return;
            }

            var workoutResponse = await Http.PostAsJsonAsync("api/workouts", new CreateWorkoutDto(workoutDate));
            if (!workoutResponse.IsSuccessStatusCode)
            {
                saveError = "Workout was not saved";
                return;
            }

            var workout = await workoutResponse.Content.ReadFromJsonAsync<WorkoutDto>();
            if (workout is null)
            {
                saveError = "Workout was not saved";
                return;
            }

            foreach (var (exercise, exerciseId) in exercisesToSave)
            {
                var workoutExerciseResponse = await Http.PostAsJsonAsync(
                    $"api/workouts/{workout.workoutId}/exercises",
                    new CreateWorkoutExerciseDto(exerciseId));

                if (!workoutExerciseResponse.IsSuccessStatusCode)
                {
                    saveError = $"Exercise \"{exercise.SearchText}\" was not added to workout";
                    return;
                }

                var workoutExercise = await workoutExerciseResponse.Content.ReadFromJsonAsync<WorkoutExerciseDto>();
                if (workoutExercise is null)
                {
                    saveError = $"Exercise \"{exercise.SearchText}\" was not added to workout";
                    return;
                }

                foreach (var set in exercise.Sets)
                {
                    if (set.Reps is null || set.Weight is null)
                        continue;

                    var setResponse = await Http.PostAsJsonAsync(
                        $"api/workouts/{workout.workoutId}/exercises/{workoutExercise.Id}/sets",
                        new CreateSetDto(set.Weight.Value, set.Reps.Value, set.Number));

                    if (!setResponse.IsSuccessStatusCode)
                    {
                        saveError = $"Set {set.Number} for \"{exercise.SearchText}\" was not saved";
                        return;
                    }
                }
            }

            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            saveError = "Could not connect to the API";
        }
        finally
        {
            isSaving = false;
        }
    }

    private Guid? FindExerciseIdByName(string name)
    {
        var trimmedName = name.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
            return null;

        return availableExercises.FirstOrDefault(e =>
            string.Equals(e.Name, trimmedName, StringComparison.OrdinalIgnoreCase))?.Id;
    }

    private async Task<ExerciseDto?> CreateExerciseAsync(string name)
    {
        var trimmedName = name.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
            return null;

        var response = await Http.PostAsJsonAsync(
            "api/exercises",
            new CreateExerciseDto { Name = trimmedName });

        if (!response.IsSuccessStatusCode)
            return null;

        return await response.Content.ReadFromJsonAsync<ExerciseDto>();
    }
}
