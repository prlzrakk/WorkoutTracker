@page "/home"
@using System.Globalization
@inject HttpClient Http
@using WorkoutTracker.Core.DTOs.Workout
@using WorkoutTracker.Core.DTOs.Exercise
@using WorkoutTracker.Core.DTOs.WorkoutExercise
@using WorkoutTracker.Core.DTOs.Set
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Workout Tracker</PageTitle>

<AppHeader/>

<main class="home-page">
    <p class="date-label">@TodayLabel</p>

    <AuthorizeView Context="authState">
        <Authorized>
            <h1 class="greeting">
                Hello, <span>@authState.User.Identity?.Name!</span>
            </h1>
        </Authorized>
    </AuthorizeView>

    <section class="panel">
        <h2>Gym this week</h2>

        <div class="week-strip">
            @foreach (var day in WeekDays)
            {
                <div class="week-day">
                    <span class="week-name">@day.Name</span>
                    <span class="week-number @(day.Active ? "active" : "")">@day.Number</span>
                </div>
            }
        </div>
    </section>

    <section class="panel today-workout-panel">
        <div class="section-head">
            <h2>Todays Workout</h2>
            <a href="/workouts">See all</a>
        </div>

        @if (isLoadingTodayWorkout)
        {
            <p class="panel-state">Loading workout...</p>
        }
        else if (todayExercises.Count == 0)
        {
            <a class="empty-workout-button" href="/create-workout" aria-label="Track today's workout">+</a>
        }
        else
        {
            <div class="workout-list">
                @foreach (var exercise in todayExercises)
                {
                    <a class="workout-row" href="@TodayWorkoutLink">
                        <span>@exercise.Name</span>
                        <span class="row-actions">-></span>
                    </a>
                }
            </div>

            <a class="add-button" href="@TodayWorkoutLink" aria-label="Add exercise">+</a>
        }
    </section>

    <section class="panel">
        <h2>Stats</h2>

        <div class="stats-grid">
            <StatCircle Label="workouts" Value="@workoutsCount.ToString()"/>
            <StatCircle Label="volume" Value="@totalVolume.ToString(CultureInfo.InvariantCulture)" ValueClass="small"/>
            <StatCircle Label="streak" Value="@streak.ToString()"/>
        </div>
    </section>

    <a class="track-button" href="/create-workout">Track a workout</a>
</main>

@code {
    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private List<WeekDay> WeekDays = [];
    private List<TodayExercise> todayExercises = [];
    private Guid? todayWorkoutId;
    private bool isLoadingTodayWorkout = true;
    private List<WorkoutDetails.WorkoutExerciseView> workoutExercises = [];
    private int workoutsCount;
    private double totalVolume;
    private int streak;


    private string TodayLabel => DateTime.Today.ToString("ddd, d MMMM yyyy", CultureInfo.InvariantCulture);
    private string TodayWorkoutLink => todayWorkoutId is null
        ? "/home"
        : $"/workouts/{todayWorkoutId}?returnUrl=/home";

    protected override async Task OnInitializedAsync()
    {
        WeekDays = BuildWeekDays([]);

        try
        {
            var workouts = await Http.GetFromJsonAsync<List<WorkoutDto>>("api/workouts") ?? [];

            workoutsCount = workouts.Count;
            totalVolume = await CountTotalVolumeAsync(workouts);
            streak = CountStreak(workouts);

            WeekDays = BuildWeekDays(workouts);

            var todayWorkout = workouts.FirstOrDefault(workout => workout.Date == today);
            if (todayWorkout is null)
            {
                return;
            }

            todayWorkoutId = todayWorkout.workoutId;

            var workoutExercises = await Http.GetFromJsonAsync<List<WorkoutExerciseDto>>(
                $"api/workouts/{todayWorkout.workoutId}/exercises") ?? [];

            if (workoutExercises.Count == 0)
            {
                return;
            }

            var exercises = await Http.GetFromJsonAsync<List<ExerciseDto>>("api/exercises") ?? [];
            var exerciseNames = exercises.ToDictionary(exercise => exercise.Id, exercise => exercise.Name);

            todayExercises = workoutExercises
                .Select(workoutExercise => new TodayExercise(
                    workoutExercise.Id,
                    exerciseNames.GetValueOrDefault(workoutExercise.ExerciseId, "Unknown exercise")))
                .ToList();
        }
        catch (HttpRequestException)
        {
            todayExercises = [];
            todayWorkoutId = null;
        }
        finally
        {
            isLoadingTodayWorkout = false;
        }
    }

    private List<WeekDay> BuildWeekDays(List<WorkoutDto> workouts)
    {
        var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        var workoutDates = workouts.Select(workout => workout.Date).ToHashSet();

        return Enumerable.Range(0, 7)
            .Select(offset =>
            {
                var date = monday.AddDays(offset);
                return new WeekDay(
                    date.ToString("ddd", CultureInfo.InvariantCulture),
                    date.Day.ToString(CultureInfo.InvariantCulture),
                    workoutDates.Contains(date));
            })
            .ToList();
    }

    private async Task<double> CountTotalVolumeAsync(List<WorkoutDto> workouts)
    {
        double volume = 0;

        foreach (var workout in workouts)
        {
            var workoutExercises = await Http.GetFromJsonAsync<List<WorkoutExerciseDto>>(
                $"api/workouts/{workout.workoutId}/exercises") ?? [];

            foreach (var workoutExercise in workoutExercises)
            {
                var sets = await Http.GetFromJsonAsync<List<SetDto>>(
                    $"api/workouts/{workout.workoutId}/exercises/{workoutExercise.Id}/sets") ?? [];

                volume += sets.Sum(set => set.Weight * set.Reps);
            }
        }

        return volume;
    }

    private int CountStreak(List<WorkoutDto> workouts)
    {
        var workoutDates = workouts
            .Select(workout => workout.Date)
            .ToHashSet();

        var date = today;

        if (!workoutDates.Contains(date))
            date = date.AddDays(-1);

        var streak = 0;

        while (workoutDates.Contains(date))
        {
            streak++;
            date = date.AddDays(-1);
        }

        return streak;
    }

    private sealed record WeekDay(string Name, string Number, bool Active);

    private sealed record TodayExercise(Guid WorkoutExerciseId, string Name);

}
