@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var loginUrl = "login";

        if (!string.IsNullOrWhiteSpace(returnUrl) &&
            !returnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase) &&
            !returnUrl.StartsWith("register", StringComparison.OrdinalIgnoreCase))
        {
            loginUrl = $"login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        }

        Navigation.NavigateTo(loginUrl, replace: true);
    }
}
